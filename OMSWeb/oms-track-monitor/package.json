{
  "name": "oms-track-monitor",
  "version": "0.0.0",
  "description": "Web Component for oms-track-monitor",
  "files": [
    "dist"
  ],
  "types": "./dist/oms-track-monitor.d.ts",
  "main": "./dist/oms-track-monitor.umd.js",
  "module": "./dist/oms-track-monitor.es.js",
  "exports": {
    ".": {
      "import": "./dist/oms-track-monitor.es.js",
      "require": "./dist/oms-track-monitor.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "buildType": "tsc src/legacies/IOmsTrackMonitor.ts --declaration --emitDeclarationOnly --outDir dist && cpy export-types/oms-track-monitor.d.ts dist/",
    "postbuild": "npm run buildType",
    "preview": "vite preview"
  },
  "dependencies": {
    "svg-pathdata": "^6.0.3",
    "vue": "^3.2.25"
  },
  "devDependencies": {
    "@types/node": "^17.0.5",
    "@types/source-map": "^0.5.7",
    "@vitejs/plugin-vue": "^2.0.0",
    "cpy-cli": "^3.1.1",
    "prettier": "2.5.1",
    "typescript": "^4.4.4",
    "vite": "^2.7.2",
    "vue-tsc": "^0.29.8"
  }
}
