{
  "name": "@daimre/oms-track-monitor",
  "version": "0.0.0",
  "description": "Web Component for oms-track-monitor",
  "files": [
    "dist"
  ],
  "types": "./dist/oms-track-monitor.d.ts",
  "main": "./dist/oms-track-monitor.umd.js",
  "module": "./dist/oms-track-monitor.es.js",
  "exports": {
    ".": {
      "import": "./dist/oms-track-monitor.es.js",
      "require": "./dist/oms-track-monitor.umd.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "dev": "vite",
    "watch": "vite build --config vite.watch.config.ts",
    "build_vue": "vite build",
    "build_types": "cpy src/Root/export-types/ dist/",
    "build": "run-s clean build_vue build_types",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.2.31"
  },
  "devDependencies": {
    "@microsoft/signalr": "^5.0.4",
    "@types/node": "^17.0.17",
    "@types/rimraf": "^3",
    "@types/source-map": "^0.5.7",
    "@types/svgo": "^2.6.2",
    "@vitejs/plugin-vue": "^2.2.0",
    "cpy-cli": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "2.5.1",
    "rimraf": "^3.0.2",
    "typescript": "^4.5.5",
    "vite": "^2.8.1",
    "vite-svg-loader": "^3.1.2",
    "vue-tsc": "^0.31.4"
  }
}
