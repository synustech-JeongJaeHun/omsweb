{
  "name": "synusdev",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow yarn",
    "ap": "yarn workspace @synusdev/app",
    "shared": "yarn workspace @synusdev/shared",
    "cl": "yarn workspace @synusdev/component-library",
    "styles": "yarn workspace @synusdev/styles",
    "otm": "yarn workspace @synusdev/oms-track-monitor",
    "fs": "yarn workspace @synusdev/fake-server",
    "clean:src": "yarn workspaces foreach -pv --exclude app run clean",
    "clean": "yarn workspaces foreach -pv run clean",
    "build:src": "yarn workspaces foreach -pvtR --from '{@synusdev/styles,@synusdev/shared,@synusdev/component-library,@synusdev/oms-track-monitor}' run build",
    "build:app": "yarn ap build",
    "build": "run-s clean build:src build:app",
    "watch:src": "yarn workspaces foreach -pi run watch",
    "storybook": "yarn cl storybook",
    "storybook:publish": "yarn cl storybook:publish",
    "ng:start": "yarn ap start",
    "start": "concurrently yarn:watch:src yarn:ng:start",
    "start:all": "yarn build:src && yarn start",
    "reset": "yarn clean && npkill"
  },
  "devDependencies": {
    "@types/prettier": "^2",
    "concurrently": "^7.1.0",
    "npkill": "^0.8.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.5.1",
    "ts-node": "^10.7.0",
    "typescript": "~3.9.5"
  },
  "packageManager": "yarn@3.2.0",
  "dependencies": {
    "speak-tts": "^2.0.8"
  }
}
