{
  "name": "yarn-workspace-starter",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow yarn",
    "ap": "yarn workspace @daimre/angularapp",
    "shared": "yarn workspace @daimre/shared",
    "cl": "yarn workspace @daimre/component-library",
    "styles": "yarn workspace @daimre/styles",
    "otm": "yarn workspace @daimre/oms-track-monitor",
    "clean:src": "yarn cl clean && yarn shared clean && yarn styles clean && yarn otm clean",
    "clean:all": "yarn workspaces foreach -pv run clean",
    "build:src": "yarn clean:src && yarn styles build && yarn shared build && yarn cl build && yarn otm build",
    "build:app": "yarn ap build",
    "build": "npm-run-all clean:all build:src build:app",
    "watch:src": "concurrently 'yarn styles watch' 'yarn shared watch' 'yarn cl watch' 'yarn otm watch'",
    "storybook": "yarn cl storybook",
    "storybook:publish": "yarn cl storybook:publish",
    "start": "yarn ap start:ng"
  },
  "devDependencies": {
    "@types/concurrently": "^6",
    "@types/prettier": "^2",
    "concurrently": "^6.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.5.1",
    "typescript": "~3.9.5"
  }
}
